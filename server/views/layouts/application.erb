<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= h(@title || "Went Hiking") %></title>
    <meta name="description" content="<%= h(page_description) %>">
    <meta name="csrf-token" content="<%= h(csrf_token) %>">
    <meta name="theme-color" content="#f7f7f4">
    <meta property="og:site_name" content="Went Hiking">
    <meta property="og:type" content="<%= h(@trip ? "article" : "website") %>">
    <meta property="og:title" content="<%= h(@title || "Went Hiking") %>">
    <meta property="og:description" content="<%= h(page_description) %>">
    <meta property="og:url" content="<%= h(canonical_url) %>">
    <meta property="og:image" content="<%= h(social_image_url) %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= h(@title || "Went Hiking") %>">
    <meta name="twitter:description" content="<%= h(page_description) %>">
    <meta name="twitter:image" content="<%= h(social_image_url) %>">
    <link rel="canonical" href="<%= h(canonical_url) %>">
    <link rel="icon" href="<%= h(static_asset_path("/favicon.ico")) %>" sizes="any">
    <link rel="preload" href="<%= h(static_asset_path("/fonts/InterVariable.woff2")) %>" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="<%= h(static_asset_path("/styles/site.css")) %>">
    <% if map_required? %>
      <link rel="preconnect" href="https://basemap.nationalmap.gov" crossorigin>
      <link rel="stylesheet" href="<%= h(static_asset_path("/vendor/leaflet/leaflet.css")) %>">
      <script src="<%= h(static_asset_path("/vendor/leaflet/leaflet.js")) %>" defer></script>
    <% end %>
    <script src="<%= h(static_asset_path("/scripts/site.js")) %>" defer></script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="wordmark" href="/">
          <%= wordmark_svg(id: "site-wordmark", class_name: "logo-svg wordmark-logo") %>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <% account = current_account %>
          <a href="/hikes">Hikes</a>
          <a href="/about">About</a>
          <% if account %>
            <a href="<%= h(account.public_path) %>">Your profile</a>
            <span class="site-nav-greeting">Hi, <%= h(first_name(account)) %>.</span>
            <a class="site-nav-add" href="/hikes/new" aria-label="Add a new hike" title="Add a new hike">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 5v14"></path>
                <path d="M5 12h14"></path>
              </svg>
            </a>
            <a href="/account">Settings</a>
          <% else %>
            <a href="/login">Log in</a>
          <% end %>
        </nav>
      </div>
    </header>
    <main>
      <%= yield %>
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <a class="footer-wordmark" href="/">
          <%= wordmark_svg(id: "footer-wordmark", class_name: "logo-svg footer-wordmark-logo") %>
        </a>
        <div>
          <p class="site-footer-migration">Went Hiking recently moved to new infrastructure. If your old password does not work, reset it to get back in; if anything feels off, please <a href="mailto:kaiuhl+wenthiking@gmail.com">send feedback</a>.</p>
          <p>Went Hiking &copy; 2010-2026. All rights reserved. All photos &copy; their respective owners. Photos may not be used or modified without express written consent of the author.</p>
          <p class="site-footer-links">
            <a href="/about">About</a>
            <span aria-hidden="true">|</span>
            <a href="/privacy">Privacy Policy</a>
            <span aria-hidden="true">|</span>
            <a href="mailto:kaiuhl+wenthiking@gmail.com">Contact</a>
          </p>
        </div>
        <div>
          <p>This website was lovingly crafted by <a href="https://kaiuhl.com">Kyle Meyer</a>, a software engineer and backpacker in Portland, Oregon.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
