<%
  # The compose page. One view serves /hikes/new and /hikes/:slug/edit: the only
  # difference is whether a trip row exists yet and whether it has been published.
  @needs_editor = true

  trip = @form_trip
  values = @form_values
  photos = @form_photos || []
  errors = @form_errors || []
  published = trip && trip.published?
  mode = if trip.nil?
    "new"
  elsif published
    "published"
  else
    "draft"
  end

  # Server-side validation errors are pinned to the control that caused them
  # rather than dumped at the top of the page.
  error_for = lambda do |*fragments|
    errors.find { |error| fragments.any? { |fragment| error.downcase.include?(fragment) } }
  end
  name_error = error_for.call("name is required")
  date_error = error_for.call("hike date")
  nights_error = error_for.call("nights")
  mileage_error = error_for.call("mileage")
  elevation_error = error_for.call("elevation")
  location_error = error_for.call("latitude", "longitude", "map pin")
  url_error = error_for.call("reference url")
  claimed = [name_error, date_error, nights_error, mileage_error, elevation_error, location_error, url_error].compact
  other_errors = errors - claimed

  nights_value = values[:nights].to_s
  nights_value = "" if nights_value == "0"
  has_location = !values[:lat].to_s.empty? && !values[:lng].to_s.empty?

  photo_items = photos.map { |photo| photo_editor_item(photo) }
  # JSON inside a <script> block: escaping "<" keeps a caption from closing the tag.
  photo_json = json(photo_items).gsub("<", "\\u003c")

  chip_error = lambda do |key, message|
    next "" unless message
    %(<span class="compose-error" data-compose-error="#{h(key)}">#{h(message)}</span>)
  end
%>

<section
  class="compose"
  data-compose
  data-mode="<%= h(mode) %>"
  data-trip-id="<%= h(trip&.id) %>"
  data-draft-url="/hikes/drafts"
  data-save-url="<%= h(@form_action) %>"
  data-autosave-url="<%= h(trip ? "#{trip.public_path}/autosave" : "") %>"
  data-upload-url="<%= h(trip ? "#{trip.public_path}/photos/direct-upload" : "") %>"
  data-photo-url="<%= h(trip ? "#{trip.public_path}/photos" : "") %>"
  data-edit-url="<%= h(trip ? "#{trip.public_path}/edit" : "") %>"
  data-trip-url="<%= h(trip&.public_path) %>"
  data-direct-upload="<%= direct_photo_upload_available? ? "true" : "false" %>"
  data-max-upload-bytes="<%= WentHiking::PhotoFile::MAX_BYTES %>"
>
  <div class="compose-bar">
    <div class="compose-bar-inner">
      <p class="compose-state" data-compose-state aria-live="polite" aria-atomic="true"><%= published ? "Published" : "Draft" %></p>

      <div class="compose-bar-actions">
        <% if published %>
          <a class="compose-bar-link" href="<%= h(trip.public_path) %>">View hike</a>
        <% end %>

        <button class="compose-primary" type="submit" form="compose-form" data-compose-submit>
          <%= published ? "Save changes" : "Publish" %>
        </button>

        <%# Rendered even before a draft row exists: the editor reveals it the
            moment the draft is created, so there is nothing to inject later. %>
          <div class="compose-menu" data-compose-menu <%= "hidden" unless trip %>>
            <button
              class="compose-menu-toggle"
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              aria-label="More hike actions"
              data-compose-menu-toggle
            >
              <span aria-hidden="true">&hellip;</span>
            </button>
            <div class="compose-menu-panel" data-compose-menu-panel hidden>
              <% if published %>
                <a href="<%= h(trip.public_path) %>">View hike</a>
              <% end %>
              <button
                class="compose-menu-danger"
                type="submit"
                form="compose-delete"
                data-compose-delete
                data-confirm="Delete this hike and every photo on it? This cannot be undone."
              >Delete hike</button>
            </div>
          </div>
      </div>
    </div>
  </div>

  <form id="compose-delete" class="compose-offscreen-form" action="<%= h(trip ? "#{trip.public_path}/delete" : "") %>" method="post" <%= "hidden" unless trip %>>
    <%= csrf_tag %>
  </form>

  <form id="compose-form" class="compose-form" action="<%= h(@form_action) %>" method="post" data-compose-form novalidate>
    <%= csrf_tag %>

    <% unless other_errors.empty? %>
      <div class="compose-alert" role="alert">
        <% other_errors.each do |error| %>
          <p><%= h(error) %></p>
        <% end %>
      </div>
    <% end %>

    <h1 class="compose-title-field">
      <label class="compose-visually-hidden" for="compose-title">Hike name</label>
      <textarea
        id="compose-title"
        class="compose-title"
        name="name"
        rows="1"
        spellcheck="false"
        autocomplete="off"
        enterkeyhint="next"
        placeholder="Name this hike"
        data-compose-title
      ><%= h(values[:name]) %></textarea>
    </h1>
    <%= chip_error.call("name", name_error) %>

    <div class="compose-byline kicker" data-compose-byline>
      <span class="compose-chip compose-chip-date">
        <label class="compose-visually-hidden" for="compose-date">Hike date</label>
        <input
          id="compose-date"
          class="compose-chip-input compose-date-input"
          type="date"
          name="hiked_at"
          value="<%= h(values[:hiked_at]) %>"
          required
          data-compose-field="hiked_at"
        >
      </span>

      <span class="compose-chip" data-compose-chip="nights">
        <label class="compose-visually-hidden" for="compose-nights">Nights out</label>
        <input
          id="compose-nights"
          class="compose-chip-input compose-chip-number"
          type="text"
          inputmode="numeric"
          name="nights"
          value="<%= h(nights_value) %>"
          placeholder="+ nights"
          autocomplete="off"
          data-compose-field="nights"
          data-compose-unit="nights"
        >
        <span class="compose-chip-unit" aria-hidden="true" data-compose-unit-label>nights</span>
      </span>

      <span class="compose-chip" data-compose-chip="mileage">
        <label class="compose-visually-hidden" for="compose-mileage">Miles walked</label>
        <input
          id="compose-mileage"
          class="compose-chip-input compose-chip-number"
          type="text"
          inputmode="decimal"
          name="mileage"
          value="<%= h(values[:mileage]) %>"
          placeholder="+ miles"
          autocomplete="off"
          data-compose-field="mileage"
          data-compose-unit="miles"
          data-compose-unit-short="mi"
        >
        <span class="compose-chip-unit" aria-hidden="true" data-compose-unit-label>miles</span>
      </span>

      <span class="compose-chip" data-compose-chip="elevation">
        <label class="compose-visually-hidden" for="compose-elevation">Feet gained</label>
        <input
          id="compose-elevation"
          class="compose-chip-input compose-chip-number"
          type="text"
          inputmode="numeric"
          name="elevation"
          value="<%= h(values[:elevation]) %>"
          placeholder="+ ft gained"
          autocomplete="off"
          data-compose-field="elevation"
          data-compose-unit="ft gained"
          data-compose-unit-short="ft"
        >
        <span class="compose-chip-unit" aria-hidden="true" data-compose-unit-label>ft gained</span>
      </span>

      <span class="compose-chip compose-chip-location" data-compose-chip="location" data-compose-location>
        <button
          class="compose-chip-button"
          type="button"
          aria-haspopup="dialog"
          aria-expanded="false"
          data-compose-location-toggle
        ><%= has_location ? "Pin set &check;" : "+ drop a pin" %></button>
        <input type="hidden" name="lat" value="<%= h(values[:lat]) %>" data-compose-field="lat">
        <input type="hidden" name="lng" value="<%= h(values[:lng]) %>" data-compose-field="lng">

        <div class="compose-popover" role="dialog" aria-label="Hike location" data-compose-location-panel hidden>
          <div
            class="compose-map"
            data-compose-map
            data-tile-url="<%= h(leaflet_tile_url) %>"
            data-default-lat="45.52"
            data-default-lng="-122.67"
            data-default-zoom="6"
            role="application"
            aria-label="Click the map to drop a pin"
          ></div>
          <p class="compose-popover-hint" data-compose-location-summary>Click the map to drop a pin.</p>
          <div class="compose-popover-row">
            <label class="compose-popover-label" for="compose-lat">Lat</label>
            <input id="compose-lat" class="compose-popover-input" type="text" inputmode="decimal" value="<%= h(values[:lat]) %>" autocomplete="off" data-compose-lat>
            <label class="compose-popover-label" for="compose-lng">Lng</label>
            <input id="compose-lng" class="compose-popover-input" type="text" inputmode="decimal" value="<%= h(values[:lng]) %>" autocomplete="off" data-compose-lng>
          </div>
          <div class="compose-popover-actions">
            <button class="compose-popover-clear" type="button" data-compose-location-clear>Clear pin</button>
            <button class="compose-popover-done" type="button" data-compose-popover-close>Done</button>
          </div>
        </div>
      </span>

      <span class="compose-chip compose-chip-link" data-compose-chip="source_url">
        <label class="compose-visually-hidden" for="compose-source-url">Reference link</label>
        <input
          id="compose-source-url"
          class="compose-chip-input compose-chip-url"
          type="url"
          name="source_url"
          value="<%= h(values[:source_url]) %>"
          placeholder="+ link"
          autocomplete="off"
          spellcheck="false"
          data-compose-field="source_url"
        >
      </span>
    </div>

    <%= chip_error.call("hiked_at", date_error) %>
    <%= chip_error.call("nights", nights_error) %>
    <%= chip_error.call("mileage", mileage_error) %>
    <%= chip_error.call("elevation", elevation_error) %>
    <%= chip_error.call("location", location_error) %>
    <%= chip_error.call("source_url", url_error) %>

    <div class="compose-canvas-shell">
      <div class="compose-canvas trip-body" data-compose-canvas hidden></div>

      <label class="compose-visually-hidden" for="compose-source">Trip report markdown</label>
      <textarea
        id="compose-source"
        class="compose-source"
        name="report_markdown"
        rows="12"
        placeholder="Tell the story&hellip;"
        data-compose-source
      ><%= h(values[:report_markdown]) %></textarea>
    </div>

    <section class="compose-tray" data-compose-tray aria-label="Photos in this hike">
      <p class="compose-tray-label" data-compose-tray-label>Also from this hike</p>
      <div class="compose-tray-grid" data-compose-tray-grid></div>
      <button class="compose-tray-drop" type="button" data-compose-tray-drop>
        <span class="compose-tray-drop-line">Drop photos here</span>
        <span class="compose-tray-drop-hint">or click to choose files</span>
      </button>
    </section>

    <input class="compose-visually-hidden" type="file" accept="image/jpeg,image/png,image/gif" multiple data-compose-file tabindex="-1" aria-hidden="true">
  </form>

  <script type="application/json" data-compose-photos><%= photo_json %></script>
</section>
