<%# Shared trip list. Locals: trips, empty_message, heading_level, show_author %>
<% heading_tag = (defined?(heading_level) && heading_level) || "h3" %>
<% with_author = defined?(show_author) ? show_author : true %>
<% if trips.empty? %>
  <p class="empty"><%= h(empty_message) %></p>
<% else %>
  <%# One query for every heart count on the page instead of one per row. The
      routes feeding this partial eager-load `account` and `photos =>
      photo_variants`, which is what keeps the loop below query-free. %>
  <% prime_heart_counts(trips) %>
  <div class="trip-list">
    <% trips.each do |trip| %>
      <% photos = trip.photos %>
      <% trip_excerpt = trip.report_markdown.to_s.gsub(PHOTO_HANDLE_PATTERN, " ").gsub(/\s+/, " ").strip %>
      <% gallery_photo_count = (trip.lat && trip.lng) ? 5 : 6 %>
      <% trip_stats = [number_label(trip.mileage, "miles"), number_label(trip.elevation, "feet gained"), night_count_label(trip.nights)].compact %>
      <article class="trip-row" <%= %(data-photo-lightbox-gallery data-photo-lightbox-items="#{h(json(photo_lightbox_items(photos)))}") unless photos.empty? %>>
        <div class="trip-row-content">
          <%# One byline, the same one the trip page opens with: date, author,
              and the numbers all speak in a single kicker instead of splitting
              into a meta line above the title and a stats line below it. %>
          <p class="kicker inline-kicker trip-row-kicker">
            <span><%= h(trip_date_label(trip)) %></span>
            <% if with_author %><span><a href="<%= h(trip.account.public_path) %>"><%= h(trip.account.name) %></a></span><% end %>
            <% if (location = trip_location_label(trip)) %>
              <span><%= h(location) %></span>
            <% end %>
            <% trip_stats.each do |stat| %>
              <span><%= h(stat) %></span>
            <% end %>
          </p>
          <div class="trip-row-heading">
            <<%= heading_tag %>><a class="trip-row-link" href="<%= h(trip.public_path) %>"><%= h(trip.name) %></a></<%= heading_tag %>>
            <%= heart_button(trip) %>
          </div>
          <% unless trip_excerpt.empty? %>
            <p class="trip-row-excerpt"><%= h(trip_excerpt[0, 360]) %><%= "..." if trip_excerpt.length > 360 %></p>
          <% end %>
        </div>
        <% if photos.any? %>
          <%= trip_photo_gallery_html(photos.first(gallery_photo_count), all_photos: photos, map_trip: trip) %>
        <% elsif trip.lat && trip.lng %>
          <div class="trip-row-map" data-static-map data-lat="<%= h(trip.lat) %>" data-lng="<%= h(trip.lng) %>" data-title="<%= h(trip.name) %>" data-tile-url="<%= h(leaflet_tile_url) %>" aria-hidden="true"></div>
        <% end %>
      </article>
    <% end %>
  </div>
<% end %>
