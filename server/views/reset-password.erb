<%# Reached from the emailed link. rodauth's template is two password fields
    and a button with nothing above them saying what they are for. %>
<div class="auth-page">
  <section class="auth-card">
    <p class="kicker">Account</p>
    <h1>Choose a new password</h1>
    <p>This link works once. Once the new password is saved you can log in with it.</p>

    <form method="post" class="rodauth" role="form" id="reset-password-form">
      <%= rodauth.reset_password_additional_form_tags %>
      <%= rodauth.csrf_tag %>
      <%= rodauth.render("password-field") %>
      <%= rodauth.render("password-confirm-field") if rodauth.require_password_confirmation? %>
      <%= rodauth.button(rodauth.reset_password_button) %>
    </form>
  </section>
</div>
