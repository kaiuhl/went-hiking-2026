<%# Reached from the emailed link after too many failed logins. rodauth's
    template is a sentence and a button under no heading. %>
<div class="auth-page">
  <section class="auth-card">
    <p class="kicker">Account</p>
    <h1>Unlock your account</h1>
    <p>Too many failed logins locked this account. Unlocking it lets you try your password again.</p>

    <form method="post" class="rodauth" role="form" id="unlock-account-form">
      <%= rodauth.unlock_account_additional_form_tags %>
      <%= rodauth.csrf_tag %>
      <%= rodauth.render("password-field") if rodauth.unlock_account_requires_password? %>
      <%= rodauth.button(rodauth.unlock_account_button) %>
    </form>
  </section>
</div>
