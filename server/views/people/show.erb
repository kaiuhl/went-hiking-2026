<% profile_map_points = @profile_map_trips.map { |trip| {lat: trip.lat, lng: trip.lng, title: trip.name, url: trip.public_path} } %>
<% trip_count = @year_totals[:trips] %>
<% trip_label = trip_count == 1 ? "trip" : "trips" %>
<% total_miles = @year_totals[:miles] %>
<% total_nights = @year_totals[:nights] %>
<% night_label = total_nights == 1 ? "night out" : "nights out" %>
<% profile_years = @trip_years || ([@year] + @other_years).uniq.sort.reverse %>
<% follow_modal_open = @follow_errors && !@follow_errors.empty? %>

<% unless profile_map_points.empty? %>
  <section class="map-band profile-map-band" aria-label="<%= h(@account.name) %> trip map">
    <div class="map-panel site-map profile-map" data-map-collection data-map-expandable data-tile-url="<%= h(leaflet_tile_url) %>" data-points="<%= h(json(profile_map_points)) %>"></div>
  </section>
<% end %>

<section class="profile-header <%= "profile-header-with-map" unless profile_map_points.empty? %>">
  <div class="profile-avatar">
    <% if (avatar = avatar_url(@account, "medium")) %>
      <img class="avatar" src="<%= h(avatar) %>" alt="">
    <% else %>
      <span><%= h(@account.name.to_s[0].to_s.upcase) %></span>
    <% end %>
  </div>
  <div class="profile-summary">
    <h1><%= h(@account.name) %></h1>
    <% if @account.location %>
      <p class="lede"><%= h(@account.location) %></p>
    <% end %>
    <div class="kicker inline-kicker profile-stats">
      <span><%= h(format_number(trip_count)) %> <%= h(trip_label) %></span>
      <% if total_miles.positive? %>
        <span><%= h(format_number(total_miles, precision: 1)) %> miles logged</span>
      <% end %>
      <% if total_nights.positive? %>
        <span><%= h(format_number(total_nights)) %> <%= h(night_label) %></span>
      <% end %>
      <span class="profile-year-label">in <%= h(@year) %></span>
      <span><a class="profile-subscribe-link" href="#profile-follow-modal" data-profile-modal-open="profile-follow-modal">Subscribe to updates</a></span>
    </div>
    <% if @follow_notice %>
      <p class="profile-follow-notice"><%= h(@follow_notice) %></p>
    <% end %>
  </div>
</section>

<div id="profile-follow-modal" class="profile-follow-modal<%= " is-open" if follow_modal_open %>" role="dialog" aria-modal="true" aria-labelledby="profile-follow-title" data-profile-follow-modal>
  <%# The backdrop is a click target, not a destination: the × button carries the
      accessible close, so the backdrop stays out of the tab order entirely. %>
  <button class="profile-modal-backdrop" type="button" tabindex="-1" aria-hidden="true" data-profile-modal-close></button>
  <section class="profile-modal-panel" tabindex="-1">
    <button class="profile-modal-close" type="button" aria-label="Close subscribe form" data-profile-modal-close>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12"></path>
        <path d="M18 6L6 18"></path>
      </svg>
    </button>
    <noscript>
      <%# Without JS the modal is opened by :target, so leaving the hash is the
          only way back out. %>
      <a class="profile-modal-close-fallback" href="<%= h(@account.public_path) %>">Close</a>
    </noscript>
    <p class="kicker">Email updates</p>
    <h2 id="profile-follow-title">Subscribe to <%= h(first_name(@account)) %>'s hikes</h2>
    <form class="profile-follow-form" action="<%= h(@account.public_path) %>/follow" method="post">
      <%= csrf_tag %>
      <% if @follow_errors && !@follow_errors.empty? %>
        <div class="profile-follow-errors" role="alert">
          <% @follow_errors.each do |error| %>
            <p><%= h(error) %></p>
          <% end %>
        </div>
      <% end %>
      <label for="follow-email">Email address</label>
      <div class="profile-follow-controls">
        <input id="follow-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" value="<%= h(@follow_email) %>" required>
        <button type="submit">Subscribe</button>
      </div>
      <p class="inline-hints">Morning-after emails. Confirmation required.</p>
      <div class="honey-field" aria-hidden="true">
        <label for="follow-company">Company</label>
        <input id="follow-company" name="company" tabindex="-1" autocomplete="off">
      </div>
    </form>
  </section>
</div>

<section class="section profile-trips-section">
  <h2 class="visually-hidden">Hikes by <%= h(@account.name) %> in <%= h(@year) %></h2>
  <% if profile_years.size > 1 %>
    <nav class="profile-years" aria-label="Trips by year">
      <span class="kicker profile-years-label" id="profile-years-label">Year</span>
      <ul aria-labelledby="profile-years-label">
        <% profile_years.each do |year| %>
          <li>
            <a class="profile-year<%= " is-current" if year == @year %>" href="<%= h(@account.public_path) %>?year=<%= h(year) %>"<%= ' aria-current="page"' if year == @year %>><%= h(year) %></a>
          </li>
        <% end %>
      </ul>
      <%# Sixteen seasons wrap three rows deep on a phone. Narrow screens swap
          the list for the platform's own picker; the links above stay for wide
          screens and for anyone without JavaScript. %>
      <form class="profile-years-form" method="get" action="<%= h(@account.public_path) %>" data-year-select>
        <label class="visually-hidden" for="profile-year-select">Year</label>
        <select class="profile-year-select" id="profile-year-select" name="year">
          <% profile_years.each do |year| %>
            <option value="<%= h(year) %>"<%= " selected" if year == @year %>><%= h(year) %></option>
          <% end %>
        </select>
        <noscript><button class="profile-years-go" type="submit">Go</button></noscript>
      </form>
    </nav>
  <% end %>
  <%= render("hikes/trip_list", locals: {trips: @trips, empty_message: "No hikes logged for this year yet.", heading_level: "h3", show_author: false}) %>
  <% if @pagination %>
    <%= render("shared/pager", locals: {pagination: @pagination, path: @pager[:path], params: @pager[:params], label: @pager[:label], noun: "hike"}) %>
  <% end %>
</section>

<%# Owner-only, and rendered at all only when there is something in it. Before
    this, a draft that got as far as a title fell out of every listing on the
    site — the sweep leaves it alone once it has a name, so the only way back to
    it was a URL nobody kept. %>
<% if @profile_drafts && !@profile_drafts.empty? %>
  <section class="section profile-drafts" aria-labelledby="profile-drafts-label">
    <p class="section-caption profile-drafts-caption" id="profile-drafts-label">
      Drafts
      <span class="profile-drafts-note">Only you can see these</span>
    </p>
    <ul class="profile-draft-list">
      <% @profile_drafts.each do |draft| %>
        <li class="profile-draft">
          <a class="profile-draft-link" href="<%= h(draft.public_path) %>/edit"><%= h(draft.name) %></a>
          <span class="profile-draft-meta">Saved <%= h(date_label(draft.updated_at)) %></span>
          <form class="profile-draft-delete" action="<%= h(draft.public_path) %>/delete" method="post">
            <%= csrf_tag %>
            <button type="submit" data-confirm-submit="Delete the draft &ldquo;<%= h(draft.name) %>&rdquo;? This cannot be undone.">Delete</button>
          </form>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
