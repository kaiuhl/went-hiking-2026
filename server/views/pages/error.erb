<section class="narrow dead-end">
  <p class="kicker"><%= h(@error_kicker || "500") %></p>
  <h1><%= h(@error_heading || "Something slipped off the trail.") %></h1>
  <p><%= h(@error_body || "An unexpected error stopped this page from loading. Try again, or head back to the trailhead.") %></p>
  <% if @error_details %>
    <pre><%= h(@error_details) %></pre>
  <% end %>

  <%= render("pages/way_back") %>
</section>
