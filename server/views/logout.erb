<%# rodauth's own logout template is a lone button on an otherwise empty page,
    with nothing saying what it does or how to back out. %>
<div class="auth-page">
  <section class="auth-card">
    <p class="kicker">Account</p>
    <h1>Log out?</h1>
    <p>You'll need to sign back in to log a hike, add photos, or heart a trip. Everything you've written stays exactly where it is.</p>
    <form method="post" class="rodauth" role="form" id="logout-form">
      <%= rodauth.logout_additional_form_tags %>
      <%= rodauth.csrf_tag %>
      <div class="form-actions">
        <button type="submit"><%= h(rodauth.logout_button) %></button>
        <a href="/">Never mind</a>
      </div>
    </form>
  </section>
</div>
