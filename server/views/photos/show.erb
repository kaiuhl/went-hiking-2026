<%# Same order the gallery and the lightbox use, so "next" means the next one
    the reader just saw. Computed here rather than in the route because the page
    already has the trip and this is presentation, not routing. %>
<% trip_photos = @trip.photos_dataset.order(:taken_at, :id).all %>
<% position = trip_photos.index { |photo| photo.id == @photo.id } %>
<% previous_photo = (position && position.positive?) ? trip_photos[position - 1] : nil %>
<% next_photo = (position && position < trip_photos.size - 1) ? trip_photos[position + 1] : nil %>

<article class="photo-page">
  <p class="breadcrumbs"><a href="<%= h(@trip.public_path) %>">Back to <%= h(@trip.name) %></a></p>
  <h1 class="visually-hidden"><%= h(@photo.caption.to_s.empty? ? "Photo from #{@trip.name}" : "#{@photo.caption} — photo from #{@trip.name}") %></h1>
  <figure>
    <img src="<%= h(image_url(@photo, "original")) %>"<%= photo_size_attributes(@photo, "original") %> alt="<%= h(@photo.caption) %>">
    <% metadata = photo_metadata_label(@photo) %>
    <% if @photo.caption || !metadata.empty? %>
      <figcaption>
        <% if @photo.caption %><p><%= h(@photo.caption) %></p><% end %>
        <% unless metadata.empty? %><p class="meta"><%= h(metadata) %></p><% end %>
      </figcaption>
    <% end %>
  </figure>

  <% if trip_photos.size > 1 %>
    <nav class="photo-pager" aria-label="Photos from this hike">
      <% if previous_photo %>
        <a class="photo-pager-step" rel="prev" href="<%= h(previous_photo.public_path) %>"><span aria-hidden="true">&larr;</span> Previous</a>
      <% else %>
        <span class="photo-pager-step is-disabled"><span aria-hidden="true">&larr;</span> Previous</span>
      <% end %>
      <p class="photo-pager-position">Photo <%= h(position + 1) %> of <%= h(trip_photos.size) %></p>
      <% if next_photo %>
        <a class="photo-pager-step" rel="next" href="<%= h(next_photo.public_path) %>">Next <span aria-hidden="true">&rarr;</span></a>
      <% else %>
        <span class="photo-pager-step is-disabled">Next <span aria-hidden="true">&rarr;</span></span>
      <% end %>
    </nav>
  <% end %>

  <nav class="photo-page-links" aria-label="More from this hike">
    <a href="<%= h(@trip.public_path) %>/photos">All <%= h(format_number(trip_photos.size)) %> photos from this hike</a>
    <a href="<%= h(@trip.public_path) %>">Read the trip report</a>
  </nav>
</article>
